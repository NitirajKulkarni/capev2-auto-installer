[Unit]
Description=CAPEv2 Web Interface Service
After=network.target cape.service

[Service]
Type=simple
User={{CAPE_USER}}
Group={{CAPE_USER}}
WorkingDirectory={{CAPE_ROOT}}/web
Environment=PYTHONPATH={{CAPE_ROOT}}
ExecStart={{PYTHON_PATH}} manage.py runserver {{WEB_BIND}}:{{WEB_PORT}}
Restart=always
RestartSec=10
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
